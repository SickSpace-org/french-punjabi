# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already in .gitignore.

# --- Supabase (existing project) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Cloudflare R2 (lesson video storage) -------------------------------
# Create a bucket + an R2 API token (Account Home > R2 > Manage API Tokens,
# "Object Read & Write" permission scoped to that bucket) and fill these in.
# Server-only — never exposed to the browser.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional override — by default the endpoint is derived from
# R2_ACCOUNT_ID as https://{account_id}.r2.cloudflarestorage.com.
R2_ENDPOINT=

# Optional. Set this ONLY if you've enabled public access on the bucket (an
# r2.dev subdomain, or a connected custom domain) and are OK with anyone who
# has a lesson's video link being able to watch it, no login required.
# Leave unset (recommended for a paid course) to keep the bucket private —
# playback URLs are then signed on demand, matching how the previous
# Supabase-storage videos were protected.
R2_PUBLIC_URL=

# --- Email (Resend) — used for enrollment confirmation + admin notification
# Sign up free at https://resend.com, create an API key, and paste it here.
# Server-only — never exposed to the browser.
RESEND_API_KEY=

# Sender address. Must be on a domain verified in your Resend account.
# If you haven't verified a domain yet, leave this unset — the app falls
# back to Resend's shared test address (onboarding@resend.dev) so email
# sending still works while you're testing.
RESEND_FROM_EMAIL="French Punjabi <enrollments@yourdomain.com>"

# Optional — if set, a "NEW ENROLLMENT" notification is also sent here
# whenever a student submits an enrollment application.
ADMIN_NOTIFICATION_EMAIL=

# --- Gemini (student chatbot) --------------------------------------------
# Create a key at https://aistudio.google.com/apikey and paste it here.
# Server-only — never exposed to the browser.
GOOGLE_GENERATIVE_AI_API_KEY=
